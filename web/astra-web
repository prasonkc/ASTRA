#!/usr/bin/env bash
#
# astra-web — single entry point for the ASTRA web application.
#
# Boots the FastAPI backend (which also serves the frontend) using the same
# virtual environment as the standalone terminal application, installing any
# missing web dependencies on first run.
#
# Usage:
#   ./web/astra-web                 # start and open the browser
#   ./web/astra-web --no-browser    # start without opening a browser
#   ./web/astra-web --port 9000     # custom port
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
CORE_DIR="${REPO_DIR}/core"
VENV_DIR="${ASTRA_VENV:-${CORE_DIR}/.venv}"
PYTHON_BIN="${ASTRA_PYTHON:-${VENV_DIR}/bin/python}"

c_blue=$'\033[94m'; c_green=$'\033[92m'; c_yellow=$'\033[93m'; c_red=$'\033[91m'; c_reset=$'\033[0m'
log()  { printf '%s[astra-web]%s %s\n' "${c_blue}" "${c_reset}" "$*"; }
ok()   { printf '%s[astra-web]%s %s\n' "${c_green}" "${c_reset}" "$*"; }
warn() { printf '%s[astra-web]%s %s\n' "${c_yellow}" "${c_reset}" "$*"; }
fail() { printf '%s[astra-web]%s %s\n' "${c_red}" "${c_reset}" "$*" >&2; exit 1; }

# --- Ensure a Python environment exists -------------------------------------
if [[ ! -x "${PYTHON_BIN}" ]]; then
  if [[ -n "${ASTRA_PYTHON:-}" ]]; then
    fail "ASTRA_PYTHON is set but not executable: ${PYTHON_BIN}"
  fi
  log "Creating virtual environment at ${VENV_DIR}"
  python3 -m venv "${VENV_DIR}" || fail "Failed to create virtual environment (is python3 installed?)"
fi

# --- Install dependencies (only when needed) --------------------------------
REQ_CORE="${REPO_DIR}/requirements.txt"
REQ_WEB="${SCRIPT_DIR}/requirements.txt"

if ! "${PYTHON_BIN}" -c "import ollama, playwright" >/dev/null 2>&1; then
  log "Installing core dependencies…"
  "${PYTHON_BIN}" -m pip install --quiet --upgrade pip
  [[ -f "${REQ_CORE}" ]] && "${PYTHON_BIN}" -m pip install --quiet -r "${REQ_CORE}"
fi

if ! "${PYTHON_BIN}" -c "import fastapi, uvicorn" >/dev/null 2>&1; then
  log "Installing web dependencies…"
  "${PYTHON_BIN}" -m pip install --quiet --upgrade pip
  "${PYTHON_BIN}" -m pip install --quiet -r "${REQ_WEB}"
fi

# --- Sanity check the active provider (non-fatal) ---------------------------
# ASTRA can run against local Ollama or a cloud provider (OpenAI, Anthropic,
# Gemini). Only nag about Ollama when it is actually the selected provider.
ACTIVE_PROVIDER="$(
  CORE_DIR="${CORE_DIR}" "${PYTHON_BIN}" - <<'PY' 2>/dev/null || true
import os, sys
sys.path.insert(0, os.environ["CORE_DIR"])
try:
    from ai import settings
    print(settings.get_settings().active_provider())
except Exception:
    print("ollama")
PY
)"
ACTIVE_PROVIDER="${ACTIVE_PROVIDER:-ollama}"

if [[ "${ACTIVE_PROVIDER}" == "ollama" ]]; then
  OLLAMA_HOST="${OLLAMA_HOST:-http://localhost:11434}"
  if command -v curl >/dev/null 2>&1; then
    if ! curl -s --max-time 3 "${OLLAMA_HOST}/api/tags" >/dev/null 2>&1; then
      warn "Ollama does not appear to be running at ${OLLAMA_HOST}."
      warn "Start it with 'ollama serve', or use the in-app Settings (⚙) to choose"
      warn "another provider or run the local setup that installs Ollama for you."
    fi
  fi
else
  log "Provider: ${ACTIVE_PROVIDER} (configure it from Settings ⚙ in the app)."
fi

ok "Starting ASTRA Web…"
exec "${PYTHON_BIN}" "${SCRIPT_DIR}/backend/run.py" "$@"
